# Firebase Configuration Template for CampusFind
# Copy this file to .env and replace the values with your actual Firebase Project credentials

VITE_FIREBASE_API_KEY=AIzaSyYourActualApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN=your-college-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-college-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-college-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456789
